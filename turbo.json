{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env.*", "tsconfig.json", "tailwind.config.js"],
  "globalEnv": [
    "NODE_ENV",
    "POSTGRES_URL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_USER",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_JWT_SECRET",
    "STRIPE_SECRET_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".expo/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*",
        "DATABASE_URL",
        "SENTRY_DSN",
        "STRIPE_SECRET_KEY"
      ]
    },
    "@apex/knowledge-graph#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.d.ts"],
      "cache": true
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "SENTRY_DSN",
        "STRIPE_SECRET_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "verify-barrels": {
      "cache": true,
      "outputs": []
    },
    "verify-schema": {
      "cache": true,
      "outputs": []
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  },
  "remoteCache": {
    "signature": true
  }
}
