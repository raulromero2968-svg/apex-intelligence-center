# Apex Intelligence - Environment Configuration Template
# Copy this file to .env.local and replace with your actual values

# Stripe Configuration (Required for Connect Integration)
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (Required for webhook verification)
# Get this from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Application Base URL
# For local development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# For production deployment (e.g., Vercel)
# NEXT_PUBLIC_BASE_URL=https://apex-intelligence-center.vercel.app

# =============================================================================
# Simulation Markets Configuration (EGGROLL + Manifold Integration)
# =============================================================================

# Manifold Markets API Key (Optional - for authenticated requests)
# Get your key from: https://manifold.markets/settings -> API
# Public markets can be accessed without auth, but rate limits are higher with key
MANIFOLD_API_KEY=

# EGGROLL Evolution Configuration (Optional - defaults shown)
# EGGROLL_POPULATION_SIZE=5
# EGGROLL_GENERATIONS=3
# EGGROLL_MUTATION_RATE=0.3
# EGGROLL_TOP_K=2
