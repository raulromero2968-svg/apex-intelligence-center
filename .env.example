# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# AI/ML APIs
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENAI_API_KEY="sk-..."
XAI_API_KEY="xai-..."
VOYAGE_API_KEY="pa-..."
COHERE_API_KEY="..."

# IPFS (Pinata)
PINATA_API_KEY="..."
