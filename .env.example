# Stripe Configuration Template
# Copy this file and fill in your actual Stripe keys
# DO NOT commit your actual keys to version control!

# Stripe Publishable Key (safe for client-side use)
# Get this from: Stripe Dashboard → Developers → API Keys
# Production: starts with pk_live_
# Test: starts with pk_test_
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE

# Stripe Price IDs
# Get these from: Stripe Dashboard → Products → [Your Product] → Pricing
# Each price ID starts with "price_"

# Premium Plan Prices
STRIPE_PRICE_PREMIUM_MONTHLY=price_YOUR_PREMIUM_MONTHLY_ID
STRIPE_PRICE_PREMIUM_YEARLY=price_YOUR_PREMIUM_YEARLY_ID

# Pro Plan Prices
STRIPE_PRICE_PRO_MONTHLY=price_YOUR_PRO_MONTHLY_ID
STRIPE_PRICE_PRO_YEARLY=price_YOUR_PRO_YEARLY_ID

# ============================================
# CONFIGURATION INSTRUCTIONS
# ============================================

# Step 1: Create Stripe Account
# - Go to stripe.com and sign up
# - Complete business verification

# Step 2: Create Products in Stripe Dashboard
#
# Premium Plan ($9.99/mo or $99/yr):
# - Product name: "Apex Intelligence Premium"
# - Create 2 prices: monthly ($9.99) and yearly ($99)
#
# Pro Plan ($29.99/mo or $299/yr):
# - Product name: "Apex Intelligence Pro"
# - Create 2 prices: monthly ($29.99) and yearly ($299)

# Step 3: Copy Keys to subscribe.html
# - Replace line 495 with your STRIPE_PUBLISHABLE_KEY
# - Replace lines 499-502 with your STRIPE_PRICE_* values

# Step 4: Test Before Going Live
# - Use test keys (pk_test_...) first
# - Test with card: 4242 4242 4242 4242
# - Verify checkout flow works
# - Switch to live keys when ready

# ============================================
# EXAMPLE (with fake keys for reference)
# ============================================

# STRIPE_PUBLISHABLE_KEY=pk_live_51AbCdEfGhIjKlMnOpQrStUvWxYz1234567890ABCDEFG
# STRIPE_PRICE_PREMIUM_MONTHLY=price_1AbCdEfGhIjKlMnO
# STRIPE_PRICE_PREMIUM_YEARLY=price_2PqRsTuVwXyZ1234
# STRIPE_PRICE_PRO_MONTHLY=price_3AbCdEfGhIjKlMnO
# STRIPE_PRICE_PRO_YEARLY=price_4PqRsTuVwXyZ1234

# ============================================
# REDIS CACHING (Optional - enables global cache)
# ============================================
# Get these from: https://console.upstash.com/
# Create a Redis database and copy the REST API credentials
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# SENTRY (Error tracking & performance monitoring)
# ============================================
# Get these from: https://sentry.io/
# Create a project and copy the DSN
SENTRY_DSN=""
SENTRY_ENV=development
SENTRY_ORG=""
SENTRY_PROJECT=""

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=https://apexintel.com
REVALIDATE_SECRET=""
