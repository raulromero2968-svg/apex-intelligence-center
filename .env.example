# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# AI/ML APIs
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENAI_API_KEY="sk-..."
XAI_API_KEY="xai-..."
VOYAGE_API_KEY="pa-..."
COHERE_API_KEY="..."

# IPFS (Pinata)
PINATA_API_KEY="..."
PINATA_API_SECRET="..."

# Monitoring
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="..."

# Redis (Upstash for Production, Local for Development)
# Production (Upstash with TLS):
REDIS_URL="rediss://default:your-password@your-redis.upstash.io:6379"
REDIS_TOKEN="..."
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Development (Local Docker):
# REDIS_URL="redis://localhost:6379"

# Intelligence Bus Configuration
INTELLIGENCE_BUS_CONCURRENCY="5" # Worker concurrency per queue
INTELLIGENCE_BUS_RATE_LIMIT="10" # Max jobs per second
INTELLIGENCE_BUS_JOB_TIMEOUT="300000" # 5 minutes in milliseconds

# Optional: Local Models
OLLAMA_HOST="http://127.0.0.1:11434"

# Optional: Notifications
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
TELEGRAM_BOT_TOKEN="..."
SENDGRID_API_KEY="..."

# Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# JWT Authentication (knowledge-05)
# Generate with: openssl rand -base64 64
JWT_SECRET="your-256-bit-secret-key-here"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-key-here"

# Stripe Monetization (CLAUDE_SESSION_10)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from running: pnpm setup-stripe
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Feature Flags
FEATURE_LIVE_PRICES="1"
NEXT_PUBLIC_FEATURE_LIVE_PRICES="1"
FEATURE_RESEARCH_STREAMING="1"

# Web Push Notifications (Watchlist)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."

# Mobile Push Notifications (FCM + Expo)
# Firebase Cloud Messaging - Download from Firebase Console > Project Settings > Service Accounts
FCM_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Expo Push Notifications - Get from https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN="..."

# Cron Job Security
CRON_SECRET="your-random-secret-for-cron-jobs"
VAPID_SUBJECT="mailto:alerts@apex-intelligence.com"

# Vercel (for programmatic rollback)
VERCEL_TOKEN="..."
VERCEL_PROJECT_ID="..."
VERCEL_TEAM_ID="..." # Optional, for team projects

# Vercel Cron Secret (to secure cron endpoints)
CRON_SECRET="..." # Generate with: openssl rand -hex 32

# Vercel Edge Config (optional, for dynamic configuration)
EDGE_CONFIG="..." # Provided by Vercel when you create an Edge Config

