{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "gitRepository": {
    "type": "github",
    "repo": "raulromero2968-svg/apex-intelligence-center"
  },
  "installCommand": "pnpm install --no-frozen-lockfile --shamefully-hoist=true",
  "buildCommand": "pnpm dlx drizzle-kit generate && pnpm build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*.ts": {
      "memory": 4096,
      "maxDuration": 300
    }
  }
}
