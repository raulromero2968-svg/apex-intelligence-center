{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm build",
  "framework": "nextjs",
  "functions": {
    "app/api/backtest/**/*": {
      "maxDuration": 60,
      "memory": 3008,
      "runtime": "nodejs20.x"
    },
    "app/api/portfolio/**/*": {
      "maxDuration": 30,
      "memory": 1536,
      "runtime": "nodejs20.x"
    },
    "app/api/rag/**/*": {
      "maxDuration": 60,
      "memory": 3008,
      "runtime": "nodejs20.x"
    },
    "app/api/jobs/**/*": {
      "maxDuration": 60,
      "memory": 1536,
      "runtime": "nodejs20.x"
    },
    "app/api/arbitrage/**/*": {
      "maxDuration": 30,
      "memory": 1024,
      "runtime": "nodejs20.x"
    }
  },
  "regions": ["iad1"],
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
