## Common Patterns

### tRPC Procedure
```typescript
export const myProcedure = publicProcedure
  .input(z.object({ id: z.string() }))
  .query(async ({ input }) => {
    return await db.query.items.findFirst({
      where: eq(items.id, input.id),
    });
  });
```

### Background Job
```typescript
export async function processJob(job: Job) {
  return Sentry.startSpan(
    { name: 'job.process', op: 'job' },
    async (span) => {
      span?.setAttribute('jobId', job.id);
      // Process job
    }
  );
}
```

### RAG Query
```typescript
export async function ragQuery(question: string) {
  const sources = await retrieveDocuments(question);
  const answer = await generateWithClaude(question, sources);
  const validation = await validateCitations(answer, sources);
  await logToIPFS(trace);
  return { answer, sources, validation };
}
```

