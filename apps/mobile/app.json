{
  "expo": {
    "name": "Apex Intelligence",
    "slug": "apex-intelligence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apex.intelligence",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely access your portfolio"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.apex.intelligence",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "apex-intelligence",
          "project": "mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "apex"
  }
}
