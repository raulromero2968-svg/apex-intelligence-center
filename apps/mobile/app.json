{
  "expo": {
    "name": "Apex Intelligence",
    "slug": "apex-intelligence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apex.intelligence",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely access your portfolio"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.apex.intelligence",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Apex Intelligence to use Face ID"
        }
      ],
      "@sentry/react-native/expo"
    ],
    "scheme": "apex",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "apex-intelligence-mobile"
      },
      "apiUrl": "${EXPO_PUBLIC_API_URL}",
      "sentryDsn": "${EXPO_PUBLIC_SENTRY_DSN}",
      "vapidPublicKey": "${EXPO_PUBLIC_VAPID_PUBLIC_KEY}",
      "appEnv": "${APP_ENV}"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/apex-intelligence-mobile"
    }
  }
}
