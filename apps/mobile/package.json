{
  "name": "@apex/mobile",
  "version": "1.0.0",
  "main": "expo-router",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:e2e": "detox test",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "build:e2e:android": "detox build --configuration android.emu.debug",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-router": "~3.4.0",
    "expo-notifications": "~0.27.0",
    "expo-constants": "~15.4.0",
    "expo-device": "~5.9.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "@react-native-firebase/app": "^19.0.0",
    "@react-native-firebase/messaging": "^19.0.0",
    "expo-build-properties": "~0.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "^5.1.3",
    "jest": "^29.2.1",
    "jest-expo": "~50.0.0",
    "detox": "^20.13.0",
    "@testing-library/react-native": "^12.4.0",
    "eslint": "^8.57.0"
  },
  "private": true
}
