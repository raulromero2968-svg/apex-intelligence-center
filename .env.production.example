# =============================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================
# Copy this to Vercel environment variables
# https://vercel.com/dashboard/[project]/settings/environment-variables

# Application
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://apex-intelligence.io/api

# Supabase (Production Project)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# Stripe (Production Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_INTELLIGENCE_PRICE_ID=price_...
STRIPE_APEX_PRICE_ID=price_...

# Email (Resend Recommended for Production)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@apex-intelligence.io

# Or SendGrid
# SENDGRID_API_KEY=SG....
# EMAIL_FROM=noreply@apex-intelligence.io

# TCGPlayer API (Production)
TCGPLAYER_PUBLIC_KEY=your_production_public_key
TCGPLAYER_PRIVATE_KEY=your_production_private_key

# eBay API (Production)
EBAY_APP_ID=your_production_app_id
EBAY_CERT_ID=your_production_cert_id

# Analytics
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.apex-intelligence.io/track

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_TIME_PRICES=true
NEXT_PUBLIC_ENABLE_PRICE_ALERTS=true
NEXT_PUBLIC_ENABLE_PORTFOLIO_SYNC=true

# Security
JWT_SECRET=your_strong_random_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Production URL
PRODUCTION_URL=https://apex-intelligence.io
VERCEL_URL=apex-intelligence.vercel.app
