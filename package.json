{
  "name": "apex-intelligence-center",
  "version": "1.0.0",
  "description": "Apex Intelligence - TCG Market Intelligence Platform",
  "main": "index.html",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@apex/web",
    "dev:mobile": "turbo dev --filter=@apex/mobile",
    "build": "turbo build",
    "build:web": "turbo build --filter=@apex/web",
    "build:mobile": "turbo build --filter=@apex/mobile",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "setup-stripe": "node setup-stripe-products.js",
    "deploy": "vercel --prod",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:smoke:api": "node scripts/test-server.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "sentry:wizard": "pnpm dlx @sentry/wizard -i nextjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:ci": "tsx scripts/seed-ci.ts",
    "build:search": "tsx scripts/build-search-index.ts",
    "db:backfill:slugs": "tsx scripts/backfill-collection-slugs.ts",
    "rag:ingest": "tsx scripts/ingest-sample-data.ts",
    "rag:setup": "pnpm db:migrate && pnpm rag:ingest",
    "validate:mdx": "node scripts/validate-mdx.mjs",
    "ci": "pnpm build:search && pnpm db:migrate && pnpm db:backfill:slugs && pnpm db:seed:ci && playwright test",
    "mirror": "DEBUG=1 scripts/vercel-local-mirror.sh",
    "sanity": "scripts/repo-sanity.sh",
    "budget:js": "MAX_CHUNK_KB=${MAX_CHUNK_KB:-300} STRICT=0 scripts/bundle-budget.sh",
    "budget:route": "MAX_ROUTE_KB=${MAX_ROUTE_KB:-500} STRICT_ROUTE=0 node scripts/route-budget.mjs",
    "budget:css": "MAX_CSS_KB=${MAX_CSS_KB:-120} STRICT_CSS=0 scripts/css-budget.sh",
    "budget:media": "MAX_MEDIA_KB=${MAX_MEDIA_KB:-300} MAX_MEDIA_VIDEO_KB=${MAX_MEDIA_VIDEO_KB:-1500} STRICT_MEDIA=0 scripts/media-budget.sh",
    "audit:env": "scripts/env-audit.sh",
    "guard:delta": "DELTA_CHUNK_KB=${DELTA_CHUNK_KB:-40} STRICT_DELTA=0 scripts/bundle-delta.sh",
    "guard:libs": "LIB_BLOCKLIST=${LIB_BLOCKLIST:-moment,chart.js/auto,echarts,fullcalendar,lodash } scripts/library-watch.sh || true",
    "snapshot": "bash scripts/offender-snapshot.sh",
    "patch:check": "git apply --check patch.diff",
    "patch:apply": "git apply --index patch.diff || git apply patch.diff && git add -A && pnpm golden",
    "golden": "pnpm build && pnpm -s budget:js && pnpm -s guard:delta && pnpm -s budget:route && pnpm -s budget:css && pnpm -s budget:media && pnpm -s audit:env && pnpm -s guard:libs && pnpm -s mirror && pnpm -s sanity",
    "rollback": "tsx scripts/rollback.ts",
    "rollback:list": "tsx scripts/rollback.ts --list"
  },
  "keywords": [
    "tcg",
    "trading-cards",
    "market-intelligence",
    "stripe"
  ],
  "author": "Apex Intelligence",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@langchain/anthropic": "^1.0.1",
    "@langchain/cohere": "^1.0.0",
    "@langchain/community": "^1.0.3",
    "@langchain/core": "^1.0.5",
    "@langchain/openai": "^1.1.1",
    "@langchain/textsplitters": "^1.0.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.3",
    "@prisma/client": "^6.19.0",
    "@sentry/nextjs": "^10.25.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.5",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "@vercel/og": "^0.8.5",
    "autoprefixer": "^10.4.22",
    "bullmq": "^5.63.2",
    "clsx": "^2.1.1",
    "cohere-ai": "^7.19.0",
    "discord-webhook-node": "^1.1.8",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.8.2",
    "jose": "^5.10.0",
    "langchain": "^1.0.4",
    "lucide-react": "^0.553.0",
    "next": "^14.2.33",
    "next-mdx-remote": "^5.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "numeric": "^1.2.6",
    "openai": "^6.9.0",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^2.9.3",
    "recharts": "^3.4.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^1.1.5",
    "socket.io": "^4.8.1",
    "sonner": "^2.0.7",
    "stripe": "^14.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@sentry/types": "^10.25.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/ui": "^4.0.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.13",
    "prisma": "^6.19.0",
    "turbo": "^2.1.2",
    "vercel": "^33.0.0",
    "vitest": "^4.0.10"
  }
}
