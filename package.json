{
  "name": "apex-intelligence-center",
  "version": "1.0.0",
  "description": "Apex Intelligence - TCG Market Intelligence Platform",
  "main": "index.html",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup-stripe": "node setup-stripe-products.js",
    "deploy": "vercel --prod",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "sentry:wizard": "pnpm dlx @sentry/wizard -i nextjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:ci": "tsx scripts/seed-ci.ts",
    "build:search": "tsx scripts/build-search-index.ts",
    "db:backfill:slugs": "tsx scripts/backfill-collection-slugs.ts",
    "ci": "pnpm build:search && pnpm db:migrate && pnpm db:backfill:slugs && pnpm db:seed:ci && playwright test"
  },
  "keywords": [
    "tcg",
    "trading-cards",
    "market-intelligence",
    "stripe"
  ],
  "author": "Apex Intelligence",
  "license": "MIT",
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.3",
    "@sentry/nextjs": "^10.25.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@upstash/redis": "^1.35.6",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.553.0",
    "next": "^14.2.33",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^2.9.3",
    "recharts": "^3.4.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^14.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "vercel": "^33.0.0"
  }
}
