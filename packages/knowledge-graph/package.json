{
  "name": "@apex/knowledge-graph",
  "version": "1.1.0",
  "description": "Unified knowledge graph for Apex Intelligence Center - TCG markets + Civilizational Analytics",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "neo4j:init": "tsx scripts/init-neo4j.ts",
    "neo4j:seed": "tsx scripts/seed-data.ts",
    "neo4j:seed:civilizational": "tsx scripts/seed-civilizational.ts",
    "neo4j:query": "tsx scripts/query-examples.ts"
  },
  "dependencies": {
    "neo4j-driver": "^5.26.0",
    "@prisma/client": "^5.17.0",
    "uuid": "^14.0.0",
