# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Fara-7B Configuration
FARA_ENDPOINT=https://api.azure.com/fara-7b
FARA_API_KEY=your_api_key_here
FARA_MAX_RETRIES=3
FARA_TIMEOUT=300000

# BrowserBase Sandbox (optional)
BROWSERBASE_URL=https://www.browserbase.com/v1/sessions

# PostgreSQL Configuration (for audit logs and structured data)
DATABASE_URL=postgresql://user:password@localhost:5432/apex_intelligence

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
