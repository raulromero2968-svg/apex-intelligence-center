{
  "name": "@apex/ui",
  "version": "0.3.0",
  "private": true,
  "description": "Apex Design System - Institutional Futurism UI components with Aerospace Dark aesthetics and Gamification System",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^18.3.5",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./atoms": {
      "types": "./src/atoms/index.ts",
      "default": "./src/atoms/index.ts"
    },
    "./molecules": {
      "types": "./src/molecules/index.ts",
      "default": "./src/molecules/index.ts"
    },
    "./organisms": {
      "types": "./src/organisms/index.ts",
      "default": "./src/organisms/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./tailwind.config": {
      "types": "./tailwind.config.ts",
      "default": "./tailwind.config.ts"
    }
  }
}
