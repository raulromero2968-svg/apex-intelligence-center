# pnpm configuration for Vercel compatibility (2025 standard)
# Ultimate fix for "Module not found" errors with Next.js + pnpm on Vercel
# node-linker=hoisted creates completely flat node_modules (like npm v6)
# shamefully-hoist=true adds extra safety for legacy tools
# Note: public-hoist-pattern removed - redundant and can conflict with node-linker
node-linker=hoisted
shamefully-hoist=true
